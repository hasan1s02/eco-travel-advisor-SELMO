# ---------------------------------------------------------------------------
# Copy to .env and fill in whichever keys you have. EVERY ONE IS OPTIONAL.
#
# With no keys at all the assistant runs entirely on the bundled datasets in
# actions/data/ and labels every figure as demonstration data in the UI. That
# is the configuration this submission was tested and graded in.
#
# .env is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Climatiq — live emission factors.       Free tier: 500 calls/month
# https://www.climatiq.io/  → Settings → API keys
CLIMATIQ_API_KEY=
CLIMATIQ_DATA_VERSION=^19

# Amadeus for Developers — hotel and flight availability.  Free sandbox tier
# https://developers.amadeus.com/  → Self-Service → My apps
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# OpenCage — forward and reverse geocoding.  Free tier: 2,500 requests/day
# https://opencagedata.com/
OPENCAGE_API_KEY=

# OpenRouteService — road distances.  Free tier: 2,000 requests/day
# https://openrouteservice.org/
OPENROUTESERVICE_API_KEY=

# Where escalations are POSTed. Unset → appended to HANDOVER_QUEUE_PATH instead.
HANDOVER_WEBHOOK_URL=
HANDOVER_QUEUE_PATH=/tmp/eco_handovers.jsonl

# Per-request timeout in seconds. Keeps the assistant inside the sub-3-second
# response requirement even when an upstream service is slow.
ECO_HTTP_TIMEOUT=2.0

# Set to 1 to force the offline datasets even when keys are present.
# Used by the test suite to exercise the fallback paths.
ECO_FORCE_OFFLINE=0
